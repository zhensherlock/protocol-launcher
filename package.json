{
  "name": "protocol-launcher",
  "version": "0.0.0",
  "description": "One-click launch URL generator for protocol-based apps.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "cross-env NODE_ENV=development turbo run dev --filter=./apps/*...",
    "build": "cross-env NODE_ENV=production turbo run build --filter=./apps/docs...",
    "build:promo": "cross-env NODE_ENV=production turbo run build --filter=./apps/promo-video",
    "check:promo": "pnpm --filter ./apps/promo-video check",
    "render:promo": "pnpm --filter ./apps/promo-video render",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "author": "zhensherlock",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhensherlock/protocol-launcher/issues"
  },
  "homepage": "https://zhensherlock.github.io/protocol-launcher",
  "keywords": [
    "protocol-launcher",
    "quick-launcher",
    "deep-link",
    "deeplink",
    "url-scheme",
    "url-generator",
    "launch-url",
    "protocol",
    "mcp",
    "modelcontextprotocol",
    "mcp-installer",
    "cursor",
    "cherry-studio",
    "llm-provider",
    "api-configuration",
    "ai-tools",
    "one-click",
    "tree-shaking",
    "esm",
    "typescript"
  ],
  "packageManager": "pnpm@10.34.3",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.1",
    "tslib": "^2.8.1",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1"
  }
}
