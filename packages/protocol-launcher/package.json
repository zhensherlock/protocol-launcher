{
  "name": "protocol-launcher",
  "version": "1.9.2",
  "description": "One-click launch URL generator for protocol-based apps.",
  "type": "module",
  "author": "zhensherlock",
  "homepage": "https://zhensherlock.github.io/protocol-launcher",
  "keywords": [
    "protocol-launcher",
    "quick-launcher",
    "deep-link",
    "deeplink",
    "url-scheme",
    "url-generator",
    "launch-url",
    "protocol",
    "mcp",
    "modelcontextprotocol",
    "mcp-installer",
    "cursor",
    "cherry-studio",
    "llm-provider",
    "api-configuration",
    "ai-tools",
    "one-click",
    "tree-shaking",
    "esm",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/index.browser.js",
  "jsdelivr": "dist/index.browser.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhensherlock/protocol-launcher.git"
  },
  "scripts": {
    "clean:dist": "rimraf dist",
    "dev": "rolldown -c rolldown.config.ts --watch --no-clear-screen",
    "build:types": "tsc",
    "build": "npm run clean:dist && npm run build:types && rolldown -c rolldown.config.ts"
  },
  "bugs": {
    "url": "https://github.com/zhensherlock/protocol-launcher/issues"
  },
  "dependencies": {
    "@protocol-launcher/shared": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cherry-studio": {
      "types": "./dist/types/cherry-studio/index.d.ts",
      "import": "./dist/cherry-studio/index.js"
    },
    "./code-buddy": {
      "types": "./dist/types/code-buddy/index.d.ts",
      "import": "./dist/code-buddy/index.js"
    },
    "./cursor": {
      "types": "./dist/types/cursor/index.d.ts",
      "import": "./dist/cursor/index.js"
    },
    "./github-desktop": {
      "types": "./dist/types/github-desktop/index.d.ts",
      "import": "./dist/github-desktop/index.js"
    },
    "./goland": {
      "types": "./dist/types/goland/index.d.ts",
      "import": "./dist/goland/index.js"
    },
    "./idea": {
      "types": "./dist/types/idea/index.d.ts",
      "import": "./dist/idea/index.js"
    },
    "./macvim": {
      "types": "./dist/types/macvim/index.d.ts",
      "import": "./dist/macvim/index.js"
    },
    "./phpstorm": {
      "types": "./dist/types/phpstorm/index.d.ts",
      "import": "./dist/phpstorm/index.js"
    },
    "./pycharm": {
      "types": "./dist/types/pycharm/index.d.ts",
      "import": "./dist/pycharm/index.js"
    },
    "./rustrover": {
      "types": "./dist/types/rustrover/index.d.ts",
      "import": "./dist/rustrover/index.js"
    },
    "./telegram": {
      "types": "./dist/types/telegram/index.d.ts",
      "import": "./dist/telegram/index.js"
    },
    "./textmate": {
      "types": "./dist/types/textmate/index.d.ts",
      "import": "./dist/textmate/index.js"
    },
    "./thunder": {
      "types": "./dist/types/thunder/index.d.ts",
      "import": "./dist/thunder/index.js"
    },
    "./vscode": {
      "types": "./dist/types/vscode/index.d.ts",
      "import": "./dist/vscode/index.js"
    },
    "./xcode": {
      "types": "./dist/types/xcode/index.d.ts",
      "import": "./dist/xcode/index.js"
    },
    "./webstorm": {
      "types": "./dist/types/webstorm/index.d.ts",
      "import": "./dist/webstorm/index.js"
    }
  }
}
