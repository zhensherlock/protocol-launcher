{
  "name": "protocol-launcher",
  "version": "1.19.0",
  "description": "One-click launch URL generator for protocol-based apps.",
  "type": "module",
  "author": "zhensherlock",
  "homepage": "https://zhensherlock.github.io/protocol-launcher",
  "keywords": [
    "protocol-launcher",
    "quick-launcher",
    "deep-link",
    "deeplink",
    "url-scheme",
    "url-generator",
    "launch-url",
    "protocol",
    "mcp",
    "modelcontextprotocol",
    "mcp-installer",
    "cursor",
    "cherry-studio",
    "llm-provider",
    "api-configuration",
    "ai-tools",
    "one-click",
    "tree-shaking",
    "esm",
    "typescript"
  ],
